{
  "name": "shellysvn",
  "version": "1.1.0-beta.2",
  "description": "A standalone Subversion client for macOS, Windows, and Linux",
  "main": "./out/main/index.js",
  "bin": {
    "shellysvn-cli": "./out/main/cli.js"
  },
  "author": {
    "name": "ShellySVN",
    "email": "hello@shellysvn.com"
  },
  "homepage": "https://github.com/shellysvn/shellysvn",
  "packageManager": "bun@1.3.5",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "site:dev": "bun run --cwd apps/site dev",
    "site:build": "bun run --cwd apps/site build",
    "site:start": "bun run --cwd apps/site start",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "bun run build && bun run verify:binaries current && electron-builder --dir",
    "build:win": "bun run build && bun run verify:binaries win32-x64 && electron-builder --win",
    "build:mac": "bun run build && bun run verify:binaries darwin-x64 darwin-arm64 && electron-builder --mac",
    "build:mac-universal": "bun run build && bun run verify:binaries darwin-x64 darwin-arm64 && electron-builder --mac --universal",
    "build:linux": "bun run build && bun run verify:binaries linux-x64 && electron-builder --linux",
    "build:linux-appimage": "bun run build && bun run verify:binaries linux-x64 && electron-builder --linux AppImage",
    "build:linux-deb": "bun run build && bun run verify:binaries linux-x64 && electron-builder --linux deb",
    "build:linux-rpm": "bun run build && bun run verify:binaries linux-x64 && electron-builder --linux rpm",
    "build:all": "bun run build && bun run verify:binaries all && electron-builder --win --mac --linux",
    "release": "bun run build && bun run verify:binaries all && electron-builder",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "analyze:bundle": "node scripts/analyze-bundle.mjs",
    "check:bundle-budget": "node scripts/analyze-bundle.mjs --check-only",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:dead-code:production": "node scripts/check-dead-code.mjs --production",
    "dead-code:report": "bun run generate:routes && knip",
    "dead-code:report:production": "bun run generate:routes && knip --production --strict",
    "dead-code:baseline": "node scripts/check-dead-code.mjs --update && node scripts/check-dead-code.mjs --production --update",
    "generate:routes": "node scripts/generate-route-tree.mjs",
    "typecheck": "bun run generate:routes && tsc -b --noEmit",
    "preview": "node scripts/preview/serve.mjs",
    "preview:shot": "node scripts/preview/shot.mjs",
    "test": "bun run test:unit",
    "test:unit": "vitest run",
    "test:perf": "node scripts/run-strict-perf-tests.mjs",
    "test:coverage": "vitest run --coverage",
    "test:skips": "node scripts/check-skipped-tests.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:remote-assets": "node scripts/check-remote-assets.mjs",
    "verify:binaries": "node scripts/verify-binaries.mjs",
    "verify:release-version": "node scripts/validate-release-version.mjs",
    "verify:release-assets": "node scripts/validate-release-assets.mjs",
    "verify:svn-workflows": "node scripts/verify-svn-ipc-contract.mjs && node scripts/verify-svn-workflows.mjs && vitest run --config vitest.real.config.ts",
    "svn:test-server:start": "node scripts/svn-test-server.mjs start",
    "svn:test-server:stop": "node scripts/svn-test-server.mjs stop",
    "svn:test-server:status": "node scripts/svn-test-server.mjs status",
    "svn:test-server:reset": "node scripts/svn-test-server.mjs reset",
    "svn:lab:up": "docker compose -f tests/fixtures/svn-compat-server/compose.yml up -d --build --wait",
    "svn:lab:down": "docker compose -f tests/fixtures/svn-compat-server/compose.yml down",
    "svn:lab:reset": "docker compose -f tests/fixtures/svn-compat-server/compose.yml down --volumes",
    "svn:lab:logs": "docker compose -f tests/fixtures/svn-compat-server/compose.yml logs --tail=200",
    "svn:lab:verify": "node scripts/verify-svn-docker-lab.mjs",
    "svn:work-server:probe": "node scripts/probe-svn-server.mjs",
    "verify:release": "bun run verify && bun run analyze:bundle",
    "test:e2e": "playwright test --config=tests/playwright.config.ts",
    "test:e2e:ui": "playwright test --config=tests/playwright.config.ts --ui",
    "test:e2e:debug": "playwright test --config=tests/playwright.config.ts --debug",
    "test:e2e:report": "playwright show-report tests/report",
    "verify": "bun run typecheck && bun run lint && bun run check:boundaries && bun run check:dead-code && bun run check:dead-code:production && bun run check:remote-assets && bun run test:skips && bun run test:unit && bun run build",
    "engine:dev": "cd packages/logic-engine && bun run src/index.ts",
    "engine:build": "cd packages/logic-engine && bun run build",
    "engine:build:all": "cd packages/logic-engine && bun run build:all",
    "cli": "node ./out/main/cli.js",
    "cli:dev": "bun run src/main/cli.ts"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@tanstack/react-query": "^5.62.0",
    "@tanstack/react-router": "^1.92.0",
    "@tanstack/react-virtual": "^3.11.0",
    "chokidar": "3",
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^5.3.6",
    "framer-motion": "^12.40.0",
    "lucide-react": "^0.563.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-syntax-highlighter": "^16.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.58.2",
    "@tanstack/router-generator": "1.159.4",
    "@tanstack/router-plugin": "^1.92.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.14",
    "@types/react-dom": "^18.3.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "autoprefixer": "^10.4.20",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.21.5",
    "jsdom": "^28.1.0",
    "knip": "^6.31.0",
    "oxfmt": "^0.36.0",
    "oxlint": "^1.51.0",
    "postcss": "^8.4.49",
    "rollup": "4.57.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.0.18",
    "yaml": "^2.9.0"
  }
}
